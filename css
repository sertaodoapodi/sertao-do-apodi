
/* CONFIGURAÇÕES GERAIS */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    color: #333;
    line-height: 1.7;
}

a {
    text-decoration: none;
}

.container {
    width: 85%;
    max-width: 1200px;
    margin: auto;
}


/* CABEÇALHO */

header {
    background: #ffffff;
    position: sticky;
    top: 0;
    z-index: 1000;
    box-shadow: 0 2px 10px #00000012;
}

.navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 6%;
}

.logo {
    width: 75px;
    height: 75px;
    object-fit: contain;
}

.menu {
    display: flex;
    align-items: center;
    gap: 20px;
    list-style: none;
}

.menu a {
    color: #315b36;
    font-size: 14px;
    font-weight: bold;
    transition: 0.3s;
}

.menu a:hover {
    color: #b77b35;
}


/* INÍCIO */

.inicio {
    min-height: 570px;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 50px 20px;

    background:
        linear-gradient(#00000080, #00000080),
        url("imagens/capa.jpg") center/cover no-repeat;

    color: white;
}

.inicio-conteudo {
    max-width: 850px;
}

.subtitulo {
    text-transform: uppercase;
    letter-spacing: 3px;
    font-size: 13px;
}

.inicio h1 {
    font-size: 55px;
    margin: 15px 0;
}

.inicio h2 {
    font-size: 24px;
    margin-bottom: 15px;
}

.inicio p {
    font-size: 17px;
}


/* BOTÕES */

.botao {
    display: inline-block;
    background: #b77b35;
    color: white;
    padding: 12px 28px;
    margin-top: 25px;
    border-radius: 5px;
    font-weight: bold;
    transition: 0.3s;
}

.botao:hover {
    background: #8c5a25;
    transform: translateY(-2px);
}


/* SEÇÕES */

.secao {
    padding: 85px 0;
    text-align: center;
}

.secao-clara {
    background: #f4f5ed;
}

.secao h2 {
    color: #315b36;
    font-size: 32px;
    margin-bottom: 25px;
}

.secao p {
    margin-bottom: 15px;
}

.identificador {
    color: #b77b35;
    font-weight: bold;
    font-size: 12px;
    letter-spacing: 3px;
}


/* CARDS */

.cards {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 25px;
    margin-top: 35px;
}

.card {
    background: white;
    width: 260px;
    padding: 28px;
    border-radius: 10px;
    box-shadow: 0 4px 15px #0000000c;
    transition: 0.3s;
}

.card:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 20px #00000015;
}

.card h3 {
    color: #315b36;
    margin-bottom: 12px;
}


/* PNAE */

.pnae {
    background: #f4f5ed;
}

.destaque-pnae {
    background: #315b36;
    color: white;
    max-width: 800px;
    margin: 40px auto;
    padding: 40px;
    border-radius: 12px;
}

.destaque-pnae .porcentagem {
    color: #e6bd73;
    font-size: 75px;
    font-weight: bold;
    display: block;
}

.destaque-pnae h3 {
    color: white;
    margin-bottom: 15px;
}

.titulo-menor {
    color: #315b36;
    font-size: 23px;
    margin-top: 40px;
}


/* ATIVIDADES */

.atividade {
    border-bottom: 4px solid #b77b35;
}

.atividade a {
    display: inline-block;
    margin-top: 15px;
    color: #315b36;
    font-weight: bold;
}

.atividade a:hover {
    color: #b77b35;
}


/* GALERIA */

.galeria {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 35px;
}

.galeria img {
    width: 100%;
    height: 240px;
    object-fit: cover;
    border-radius: 10px;
    transition: 0.3s;
}

.galeria img:hover {
    transform: scale(1.03);
}


/* PARCERIAS */

.parcerias {
    background: #ffffff;
}

.parceiros-cards {
    align-items: stretch;
}

.parceiro {
    display: flex;
    flex-direction: column;
    align-items: center;
}

.parceiro img {
    width: 130px;
    height: 110px;
    object-fit: contain;
    margin-bottom: 20px;
}

.parceiro h3 {
    font-size: 23px;
}

.parceiro a {
    color: #315b36;
    font-weight: bold;
    margin-top: auto;
    padding-top: 20px;
}

.parceiro a:hover {
    color: #b77b35;
}


/* CONTATO */

.contato {
    background: #f4f5ed;
}

.contato a:not(.botao) {
    color: #315b36;
    font-weight: bold;
}


/* RODAPÉ */

footer {
    background: #203e26;
    color: white;
    text-align: center;
    padding: 30px 15px;
}

footer p {
    margin: 5px;
    font-size: 14px;
}


/* RESPONSIVIDADE */

@media (max-width: 900px) {

    .navbar {
        flex-direction: column;
        gap: 15px;
    }

    .menu {
        flex-wrap: wrap;
        justify-content: center;
    }

    .galeria {
        grid-template-columns: repeat(2, 1fr);
    }

}

@media (max-width: 600px) {

    .container {
        width: 90%;
    }

    .inicio {
        min-height: 450px;
    }

    .inicio h1 {
        font-size: 38px;
    }

    .inicio h2 {
        font-size: 20px;
    }

    .secao {
        padding: 60px 0;
    }

    .secao h2 {
        font-size: 26px;
    }

    .cards {
        flex-direction: column;
        align-items: center;
    }

    .card {
        width: 100%;
    }

    .galeria {
        grid-template-columns: 1fr;
    }

    .galeria img {
        height: 230px;
    }

    .destaque-pnae {
        padding: 25px;
    }

    .destaque-pnae .porcentagem {
        font-size: 55px;
    }

}
